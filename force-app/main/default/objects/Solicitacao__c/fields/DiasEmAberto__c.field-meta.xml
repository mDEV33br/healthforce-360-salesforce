<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DiasEmAberto__c</fullName>
    <description>Quantidade de dias decorridos desde a abertura até hoje ou até a conclusão.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(DataConclusao__c), ROUND(NOW() - DataAbertura__c, 0), ROUND(DataConclusao__c - DataAbertura__c, 0))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Dias em Aberto</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
